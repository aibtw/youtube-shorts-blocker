{
    "manifest_version": 3,
    "name": "YouTube Shorts Blocker",
    "version": "1.0.0",
    "description": "Hides YouTube Shorts links, shelves, and suggestions.",
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
            "js": ["content.js"],
            "run_at": "document_start"
        }
    ]
}
